{
    "name": "horde/eventdispatcher",
    "description": "A simple PSR-14 EventDispatcher / ListenerProvider system for Horde",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "lang@b1-systems.de",
            "role": "lead"
        }
    ],
    "time": "2025-05-03",
    "repositories": [],
    "require": {
        "php": "^8",
        "horde/exception": "^3",
        "psr/event-dispatcher": "^1.0.0",
        "fig/event-dispatcher-util": "^1.3",
        "ext-pcre": "*",
        "ext-simplexml": "*",
        "ext-spl": "*"
    },
    "require-dev": {
        "horde/log": "^3",
        "phpunit/phpunit": "^10 || ^11 || ^12"
    },
    "suggest": {
        "horde/log": "^3",
        "psr/log": "^1.1.4"
    },
    "autoload": {
        "psr-4": {
            "Horde\\EventDispatcher\\": "src/"
        }
    },
    "autoload-dev": {},
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    }
}