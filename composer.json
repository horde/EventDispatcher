{
    "name": "horde/eventdispatcher",
    "description": "A simple PSR-14 EventDispatcher / ListenerProvider system for Horde",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "lead"
        }
    ],
    "keywords": [
        "events",
        "event-dispatcher",
        "psr-14"
    ],
    "time": "2026-06-27",
    "repositories": [],
    "require": {
        "php": "^8",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "psr/event-dispatcher": "^1.0.0",
        "fig/event-dispatcher-util": "^1.3",
        "ext-pcre": "*",
        "ext-simplexml": "*",
        "ext-spl": "*"
    },
    "require-dev": {
        "horde/log": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/log": "^3 || dev-FRAMEWORK_6_0",
        "psr/log": "^1.1.4"
    },
    "autoload": {
        "psr-4": {
            "Horde\\EventDispatcher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\EventDispatcher\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "1.x-dev"
        }
    }
}